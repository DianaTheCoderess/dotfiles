[user]
  name = art3mis
  email = diana@bendziula.com
[gpg]
	program = gpg
[commit]
	gpgSign = false
[tag]
	forceSignAnnotated = false
[core]
	pager = delta
	excludesfile = ~/.gitignore
	autocrlf = input
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
  navigate = true    # use n and N to move between diff sections
  light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[credentials]
	helper = osxkeychain
[push]
	autoSetupRemote = true
[includeIf "gitdir:/Users/artemis/dev/parimeo/"]
  path = /Users/artemis/dev/parimeo/.gitconfig-parimeo
[includeIf "gitdir:/Users/artemis/bdr_dev/"]
  path = /Users/artemis/bdr_dev/.gitconfig-bdr

